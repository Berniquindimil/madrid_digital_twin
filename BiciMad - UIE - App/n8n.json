    {
      "parameters": {
        "jsCode": "// Procesar bicis\nconst bicis = $json.nodes[1].data.map(station => ({\n  type: 'bike_station',\n  id: station.id,\n  name: station.name,\n  address: station.address,\n  latitude: station.geometry.coordinates[1],\n  longitude: station.geometry.coordinates[0],\n  available_bikes: station.dock_bikes,\n  free_bases: station.free_bases,\n  total_bases: station.total_bases,\n  is_active: station.activate === 1\n}));\n\n// Procesar paradas de bus\nconst stops = $json.nodes[2].data?.map(stop => ({\n  type: 'bus_stop',\n  id: stop.id,\n  name: stop.name,\n  address: stop.address,\n  latitude: stop.geometry.coordinates[1],\n  longitude: stop.geometry.coordinates[0],\n  lines: stop.lines || []\n})) || [];\n\n// Procesar líneas de bus\nconst lines = $json.nodes[3].data?.map(line => ({\n  type: 'bus_line',\n  id: line.id,\n  name: line.name,\n  poliline: line.poliline\n})) || [];\n\nreturn {\n  bicis: bicis,\n  stops: stops,\n  lines: lines,\n  timestamp: new Date().toISOString()\n};"
      },
